[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/synty_color_tool/dock.gd" id="1_dock"]

[node name="SyntyColorTool" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dock")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Synty Sidekick (Godot)"
horizontal_alignment = 1

[node name="LoadButton" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "Load Selected Character"

[connection signal="pressed" from="VBoxContainer/LoadButton" to="." method="_on_load_pressed"]

[node name="StatusLabel" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Select a character in the Scene tab, then click Load."
autowrap_mode = 2

[node name="HSeparator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="PartsList" type="VBoxContainer" parent="VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
